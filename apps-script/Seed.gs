/**
 * Nelio · the demo office (D36, D37).
 *
 *   seedDemo()          Run from the editor. Reads demo/seed.json from GitHub, deletes the data
 *                       in the sheet and writes the demo office in its place: 60 clients, two
 *                       closed months and the open month. Then it creates the files in Drive.
 *                       It runs only in demo mode (Settings > demo_mode = TRUE).
 *   seedDemoFiles()     Run from the editor to create the files, if seedDemo stopped before them
 *                       (for example, before the documents of the demo reached GitHub).
 *   seedDemoContinue()  The time trigger that goes on by itself. Not for running by hand.
 *
 * The data is generated by demo/generate_seed.py, and the documents live on the demo-assets
 * branch (demo/render_docs.py). Tokens and e-mail addresses are created here, so they are never
 * in the public repository (rules.md).
 *
 * Apps Script stops every run after 6 minutes. The files are created in rounds of a few minutes,
 * and each round leaves a time trigger for the next one, until all the files are in Drive.
 */

const SEED = {
  url: 'https://raw.githubusercontent.com/shedmi-cpa/nelio/main/demo/seed.json',
  timeBudgetMs: 4.5 * 60 * 1000,
  batch: 10,              // files downloaded and created together
  stateKey: 'SEED_STATE',
  trigger: 'seedDemoContinue',
  oldTestFolder: 'בדיקות שלד',
};

function seedDemo() {
  const startedAt = Date.now();
  assertOfficeAccount_();
  if (!isChecked_(getSetting_('demo_mode'))) {
    throw new Error('seedDemo מוחק את כל הנתונים בגיליון, ולכן הוא רץ רק במצב הדגמה (Settings > demo_mode = TRUE).');
  }
  const seed = fetchSeed_();
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(CONFIG.lockTimeoutMs)) throw new Error('המערכת עסוקה כרגע. נסו שוב בעוד דקה.');
  let links;
  try {
    deleteSeedTriggers_();
    cleanupBeforeSeed_();
    links = writeSeedSheets_(seed);
    saveSeedState_({ seedId: seed.seed_id, next: 0, total: seed.uploads.length, driveMode: 'api',
      rejected: {}, runningUntil: 0 });
    logEvent_({ actor: 'system', event: 'seed', details: 'הוקם משרד הדמו (' + seed.seed_id + '): ' +
      seed.clients.length + ' לקוחות, ' + seed.requests.length + ' בקשות, ' + seed.uploads.length +
      ' קבצים, ' + seed.messages.length + ' הודעות.' });
    SpreadsheetApp.flush();
  } finally {
    lock.releaseLock();
  }
  console.log('הנתונים של משרד הדמו נכתבו לגיליון (' + seed.seed_id + ').');
  links.forEach(function (line) { console.log(line); });
  console.log('עכשיו נוצרים הקבצים ב-Drive.');
  seedFilesRun_(startedAt);
}

function seedDemoFiles() {
  assertOfficeAccount_();
  seedFilesRun_(Date.now());
}

function seedDemoContinue() {
  seedFilesRun_(Date.now());
}

// ============================================================
// Part 1: the sheet
// ============================================================

function fetchSeed_() {
  const response = UrlFetchApp.fetch(SEED.url + '?t=' + Date.now(), { muteHttpExceptions: true });
  const code = response.getResponseCode();
  if (code !== 200) throw new Error('לא הצלחתי להוריד את נתוני הדמה מגיטהאב (קוד ' + code + '): ' + SEED.url);
  const seed = JSON.parse(response.getContentText('UTF-8'));
  if (seed.format !== 1) throw new Error('הפורמט של seed.json לא מוכר: ' + seed.format);
  return seed;
}

// The leftovers of the skeleton (status.md): the folders of the test clients and of previous
// demos, the folder of the tests of 3.1, and the month folders kept in the script properties.
// Folders go to the trash, where Google keeps them for 30 days.
function cleanupBeforeSeed_() {
  const root = ensureRootFolder_();
  const folders = root.getFolders();
  while (folders.hasNext()) folders.next().setTrashed(true);
  const files = root.getFiles();
  while (files.hasNext()) files.next().setTrashed(true);
  const old = DriveApp.getFoldersByName(SEED.oldTestFolder);
  while (old.hasNext()) old.next().setTrashed(true);
  const props = PropertiesService.getScriptProperties();
  props.getKeys().forEach(function (key) {
    if (key.indexOf('MONTH_FOLDER:') === 0 || key === 'TEST_TOKEN') props.deleteProperty(key);
  });
}

// Writes every tab of the demo. Returns lines with the test links.
function writeSeedSheets_(seed) {
  const officeName = getSetting_('office_name') || defaultSettings_()[0][1];
  const docTypes = defaultDocTypes_();
  const docNames = {};
  const labels = {};
  docTypes.forEach(function (d) { docNames[d.doc_type_id] = d.name_he; labels[d.doc_type_id] = d.file_label; });

  // The settings of the demo. The office's own details (name, address, folder) stay as they are.
  const keep = ['office_name', 'system_name', 'office_email', 'client_page_url', 'drive_root_folder_id'];
  setSettings_(defaultSettings_().filter(function (s) { return keep.indexOf(s[0]) === -1; })
    .map(function (s) { return [s[0], s[1]]; }));

  writeTable_('Staff', seed.staff.map(function (s) {
    return { staff_id: s.staff_id, name: s.name, role: s.role, email: plusAddress_(s.email_tag), active: s.active };
  }));
  writeTable_('DocTypes', docTypes);
  writeTable_('Profiles', defaultProfiles_());
  const templates = defaultTemplates_();
  writeTable_('Templates', templates);
  writeTable_('Holidays', seed.holidays);

  // Clients, each with a new token.
  const tokens = {};
  const clientsById = {};
  writeTable_('Clients', seed.clients.map(function (c) {
    tokens[c.client_id] = newToken_();
    clientsById[c.client_id] = c;
    return {
      client_id: c.client_id, business_name: c.business_name, contact_name: c.contact_name,
      email: plusAddress_(c.email_tag), phone: c.phone, profile_id: c.profile_id,
      has_employees: c.has_employees, frequency: c.frequency, legal_type: c.legal_type,
      bookkeeper_id: c.bookkeeper_id, token: tokens[c.client_id], token_created_at: c.token_created_at,
      active: c.active, drive_folder_id: '', notes: c.notes,
    };
  }));

  writeTable_('Cycles', seed.cycles);
  const requestsById = {};
  seed.requests.forEach(function (r) { requestsById[r.request_id] = r; });
  writeTable_('Requests', seed.requests);
  writeTable_('Items', seed.items);

  // Uploads: the names in Drive follow D31, exactly as for a live upload.
  const storedNames = {};
  writeTable_('Uploads', seed.uploads.map(function (u) {
    const client = clientsById[u.client_id];
    const name = buildFileName_({ businessName: client.business_name, clientId: u.client_id },
      requestsById[u.request_id].period, labels[u.doc.type], u.seq, ALLOWED_TYPES[u.mime_type]);
    storedNames[u.upload_id] = name;
    return {
      upload_id: u.upload_id, uploaded_at: u.uploaded_at, item_id: u.item_id, request_id: u.request_id,
      client_id: u.client_id, uploaded_by: u.uploaded_by, original_name: u.original_name,
      stored_name: name, seq: u.seq, drive_file_id: '', mime_type: u.mime_type, size_bytes: '',
      file_hash: '', duplicate_of: u.duplicate_of, upload_key: u.upload_key, status: u.status,
    };
  }));

  // Messages: written from the templates, as at the moment they were sent (D11: logged, not sent).
  // A message from before a client's new link holds the old link, which no longer works.
  const templateById = {};
  templates.forEach(function (t) { templateById[t.template_id] = t; });
  const staffById = {};
  seed.staff.forEach(function (s) { staffById[s.staff_id] = s; });
  const oldTokens = {};
  writeTable_('Messages', seed.messages.map(function (m) {
    const client = m.client_id ? clientsById[m.client_id] : null;
    const staff = m.staff_id ? staffById[m.staff_id] : null;
    let token = client ? tokens[m.client_id] : '';
    if (client && new Date(m.created_at) < new Date(client.token_created_at)) {
      token = oldTokens[m.client_id] || (oldTokens[m.client_id] = newToken_());
    }
    const values = messageValues_({ ctx: m.ctx }, {
      client: client, staff: staff, request: requestsById[m.request_id], cycleId: m.cycle_id,
      docNames: docNames, clientsById: clientsById, officeName: officeName,
      link: client ? buildClientLink_(token) : '',
    });
    const template = templateById[m.template_id];
    return {
      message_id: m.message_id, created_at: m.created_at, send_after: m.send_after,
      template_id: m.template_id, cycle_id: m.cycle_id, request_id: m.request_id,
      client_id: m.client_id, staff_id: m.staff_id,
      to_email: plusAddress_(client ? client.email_tag : staff.email_tag),
      subject: renderTemplate_(template.subject, values), body: renderTemplate_(template.body, values),
      status: m.status, sent_at: m.sent_at, note: m.note, created_by: m.created_by,
    };
  }));

  const realAt = new Date();
  writeTable_('Log', seed.log.map(function (row) {
    return {
      at: row.at, real_at: realAt, actor: row.actor, event: row.event, client_id: row.client_id,
      request_id: row.request_id, item_id: row.item_id,
      details: row.upload_id ? row.details_template.replace('{file}', storedNames[row.upload_id]) : row.details,
    };
  }));

  // Ready links for testing (Settings > test_link, test_link_2).
  const bakery = seed.clients.filter(function (c) { return c.client_id === 'C07'; })[0];
  const joe = seed.clients.filter(function (c) { return c.business_name.indexOf("ג'ו") === 0; })[0];
  const pairs = [['test_link', buildClientLink_(tokens[bakery.client_id])]];
  if (joe) pairs.push(['test_link_2', buildClientLink_(tokens[joe.client_id])]);
  setSettings_(pairs);
  forgetModelCache_();
  return [bakery.business_name + ': ' + pairs[0][1]].concat(joe ? [joe.business_name + ': ' + pairs[1][1]] : []);
}

// Replaces all the rows of a tab. Formats first, so text stays text; dates from the seed
// ("2026-11-01T09:00:00+02:00", "2026-11-12") become real dates.
function writeTable_(sheetName, records) {
  const sheet = getSheet_(sheetName);
  const headers = getHeaders_(sheet);
  const oldRows = sheet.getMaxRows() - 1;
  if (oldRows > 0) {
    const old = sheet.getRange(2, 1, oldRows, sheet.getMaxColumns());
    old.clearContent();
    old.clearDataValidations();
  }
  if (!records.length) return;
  if (sheet.getMaxRows() < records.length + 1) {
    sheet.insertRowsAfter(sheet.getMaxRows(), records.length + 1 - sheet.getMaxRows());
  }
  const formats = headers.map(function (h) { return columnFormat_(sheetName, h); });
  headers.forEach(function (h, i) {
    sheet.getRange(2, i + 1, records.length, 1).setNumberFormat(numberFormat_(formats[i]));
  });
  const values = records.map(function (record) {
    return headers.map(function (h, i) { return seedValue_(record[h], formats[i]); });
  });
  for (let start = 0; start < values.length; start += 2000) {
    const chunk = values.slice(start, start + 2000);
    sheet.getRange(2 + start, 1, chunk.length, headers.length).setValues(chunk);
  }
  const checkbox = SpreadsheetApp.newDataValidation().requireCheckbox().build();
  headers.forEach(function (h, i) {
    if (formats[i] === 'checkbox') sheet.getRange(2, i + 1, records.length, 1).setDataValidation(checkbox);
  });
}

function seedValue_(value, format) {
  if (value === undefined || value === null) return '';
  if ((format === 'datetime' || format === 'date') && typeof value === 'string') {
    if (!value) return '';
    return /^\d{4}-\d{2}-\d{2}$/.test(value) ? dateOf_(value) : new Date(value);
  }
  return value;
}

// ============================================================
// Part 2: the files in Drive
// ============================================================

function seedFilesRun_(startedAt) {
  const state = readSeedState_();
  if (!state) {
    console.log('אין הקמה שמחכה לקבצים. כדי להקים את משרד הדמו מההתחלה, הריצו את seedDemo.');
    deleteSeedTriggers_();
    return;
  }
  if (state.runningUntil > Date.now()) {
    console.log('סבב אחר של ההקמה רץ עכשיו. אין צורך לעשות כלום.');
    return;
  }
  state.runningUntil = Date.now() + 6 * 60 * 1000;
  saveSeedState_(state);
  try {
    const seed = fetchSeed_();
    if (seed.seed_id !== state.seedId) {
      throw new Error('הקובץ seed.json השתנה מאז ההקמה (' + state.seedId + ' -> ' + seed.seed_id +
        '). הריצו את seedDemo מההתחלה.');
    }
    if (state.next < state.total && !assetReady_(seed.assets_base, seed.uploads[state.next])) {
      state.runningUntil = 0;
      saveSeedState_(state);
      deleteSeedTriggers_();
      const waiting = 'מסמכי הדמה עוד לא בגיטהאב. הנתונים בגיליון מוכנים, והקבצים ייווצרו ב-Drive ' +
        'כשתריצו את seedDemoFiles.';
      logEvent_({ actor: 'system', event: 'seed_files_waiting', details: waiting });
      console.log(waiting);
      return;
    }
    const ctx = seedFileContext_(seed);
    // At least one batch in every round, so a round always moves forward.
    let first = true;
    while (state.next < state.total && (first || Date.now() - startedAt < SEED.timeBudgetMs)) {
      first = false;
      const batch = seed.uploads.slice(state.next, state.next + SEED.batch);
      createSeedBatch_(batch, state.next, ctx, state);
      state.next += batch.length;
      state.runningUntil = Date.now() + 6 * 60 * 1000;
      saveSeedState_(state);
    }
    if (state.next >= state.total) {
      deleteSeedTriggers_();
      PropertiesService.getScriptProperties().deleteProperty(SEED.stateKey);
      forgetModelCache_();
      const done = 'כל ' + state.total + ' הקבצים של משרד הדמו נוצרו ב-Drive.' +
        (state.driveMode === 'driveapp' ? ' (בלי תאריך ההעלאה המדומה: ה-API של Drive לא היה זמין.)' : '');
      logEvent_({ actor: 'system', event: 'seed_files_done', details: done });
      console.log(done);
    } else {
      state.runningUntil = 0;
      saveSeedState_(state);
      scheduleSeedContinue_();
      const progress = 'נוצרו ' + state.next + ' מתוך ' + state.total + ' קבצים. ההקמה ממשיכה לבד בעוד כדקה.';
      logEvent_({ actor: 'system', event: 'seed_progress', details: progress });
      console.log(progress);
    }
  } catch (err) {
    state.runningUntil = 0;
    saveSeedState_(state);
    logError_('seedFiles', err);
    throw err;
  }
}

function seedFileContext_(seed) {
  const clients = {};
  readTable_('Clients').forEach(function (r) {
    clients[String(r.client_id)] = { row: r._row, clientId: String(r.client_id),
      businessName: String(r.business_name), folderId: String(r.drive_folder_id || '') };
  });
  const requests = {};
  readTable_('Requests').forEach(function (r) {
    requests[String(r.request_id)] = { row: r._row, period: String(r.period),
      folderId: String(r.drive_folder_id || '') };
  });
  return {
    clients: clients,
    requests: requests,
    assetsBase: seed.assets_base,
    rootId: getSetting_('drive_root_folder_id'),
    token: ScriptApp.getOAuthToken(),
  };
}

function assetReady_(base, upload) {
  return UrlFetchApp.fetch(base + upload.asset, { muteHttpExceptions: true }).getResponseCode() === 200;
}

// One round: downloads the documents together, creates their folders, creates the files together
// (with the date of the upload), and writes the file ID, size and fingerprint to Uploads.
function createSeedBatch_(batch, startIndex, ctx, state) {
  const sheet = getSheet_('Uploads');
  const headers = getHeaders_(sheet);
  const range = sheet.getRange(2 + startIndex, 1, batch.length, headers.length);
  const rows = range.getValues();
  const col = function (name) { return headers.indexOf(name); };

  const downloads = UrlFetchApp.fetchAll(batch.map(function (u) {
    return { url: ctx.assetsBase + u.asset, muteHttpExceptions: true };
  }));
  const files = batch.map(function (u, i) {
    if (String(rows[i][col('upload_id')]) !== u.upload_id) {
      throw new Error('השורה של ' + u.upload_id + ' בלשונית Uploads לא במקום. הריצו את seedDemo מההתחלה.');
    }
    const code = downloads[i].getResponseCode();
    if (code !== 200) throw new Error('המסמך ' + u.asset + ' לא נמצא בגיטהאב (קוד ' + code + ').');
    return { upload: u, name: String(rows[i][col('stored_name')]), bytes: downloads[i].getContent() };
  });

  files.forEach(function (f) { f.folderId = seedFolderFor_(f.upload, ctx, state); });

  if (state.driveMode === 'api') {
    const answers = UrlFetchApp.fetchAll(files.map(function (f) { return driveUploadRequest_(f, ctx.token); }));
    files.forEach(function (f, i) {
      const code = answers[i].getResponseCode();
      if (code === 200) f.fileId = JSON.parse(answers[i].getContentText()).id;
      else f.error = code + ': ' + answers[i].getContentText().slice(0, 300);
    });
    const failed = files.filter(function (f) { return !f.fileId; });
    const apiOff = failed.filter(function (f) {
      return /accessNotConfigured|SERVICE_DISABLED|has not been used|is disabled/.test(f.error);
    })[0];
    if (apiOff) {
      // Drive's API is off for this project: from now on the files are created without the date.
      state.driveMode = 'driveapp';
      logEvent_({ actor: 'system', event: 'seed_note',
        details: 'ה-API של Drive לא זמין, ולכן הקבצים נוצרים בלי תאריך ההעלאה המדומה. ' + apiOff.error });
    } else {
      failed.forEach(function (f) {
        Utilities.sleep(1500);   // probably too many requests at once: one more try, alone
        const request = driveUploadRequest_(f, ctx.token);
        const url = request.url;
        delete request.url;
        const again = UrlFetchApp.fetch(url, request);
        if (again.getResponseCode() === 200) f.fileId = JSON.parse(again.getContentText()).id;
      });
    }
  }
  files.forEach(function (f) {
    if (!f.fileId) {
      const blob = Utilities.newBlob(f.bytes, f.upload.mime_type, f.name);
      f.fileId = DriveApp.getFolderById(f.folderId).createFile(blob).getId();
    }
  });

  files.forEach(function (f, i) {
    rows[i][col('drive_file_id')] = f.fileId;
    rows[i][col('size_bytes')] = f.bytes.length;
    rows[i][col('file_hash')] = sha256OfText_(Utilities.base64Encode(f.bytes));
  });
  range.setValues(rows);
}

// The folder of a file: the month folder of its request, or "נדחו" inside it for a rejected file
// (D31). Folders are created on the first file, and their IDs are saved as in a live upload.
function seedFolderFor_(upload, ctx, state) {
  const req = ctx.requests[upload.request_id];
  if (!req.folderId) {
    const client = ctx.clients[upload.client_id];
    if (!client.folderId) {
      client.folderId = DriveApp.getFolderById(ctx.rootId).createFolder(clientFolderName_(client)).getId();
      setCell_('Clients', client.row, 'drive_folder_id', client.folderId);
    }
    req.folderId = DriveApp.getFolderById(client.folderId).createFolder(req.period).getId();
    setCell_('Requests', req.row, 'drive_folder_id', req.folderId);
  }
  if (upload.status !== 'rejected') return req.folderId;
  if (!state.rejected[upload.request_id]) {
    state.rejected[upload.request_id] =
      DriveApp.getFolderById(req.folderId).createFolder(CONFIG.rejectedFolderName).getId();
  }
  return state.rejected[upload.request_id];
}

function setCell_(sheetName, row, header, value) {
  const sheet = getSheet_(sheetName);
  sheet.getRange(row, getHeaders_(sheet).indexOf(header) + 1).setValue(value);
}

// A file created through Drive's API, with the date of the upload as its "modified" date, so the
// folder does not show that all the files were created on the same day.
function driveUploadRequest_(f, token) {
  const boundary = 'nelio-' + Utilities.getUuid();
  const metadata = {
    name: f.name,
    parents: [f.folderId],
    mimeType: f.upload.mime_type,
    modifiedTime: new Date(f.upload.uploaded_at).toISOString(),
  };
  const head = '--' + boundary + '\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n' +
    JSON.stringify(metadata) + '\r\n--' + boundary + '\r\nContent-Type: ' + f.upload.mime_type + '\r\n\r\n';
  const tail = '\r\n--' + boundary + '--\r\n';
  const payload = utf8Bytes_(head).concat(f.bytes, utf8Bytes_(tail));
  return {
    url: 'https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id',
    method: 'post',
    contentType: 'multipart/related; boundary=' + boundary,
    payload: payload,
    headers: { Authorization: 'Bearer ' + token },
    muteHttpExceptions: true,
  };
}

function utf8Bytes_(text) {
  return Utilities.newBlob('').setDataFromString(text, 'UTF-8').getBytes();
}

// ============================================================
// The state of the seeding, between rounds
// ============================================================

function readSeedState_() {
  const text = PropertiesService.getScriptProperties().getProperty(SEED.stateKey);
  return text ? JSON.parse(text) : null;
}

function saveSeedState_(state) {
  PropertiesService.getScriptProperties().setProperty(SEED.stateKey, JSON.stringify(state));
}

function scheduleSeedContinue_() {
  deleteSeedTriggers_();
  ScriptApp.newTrigger(SEED.trigger).timeBased().after(60 * 1000).create();
}

function deleteSeedTriggers_() {
  ScriptApp.getProjectTriggers().forEach(function (trigger) {
    if (trigger.getHandlerFunction() === SEED.trigger) ScriptApp.deleteTrigger(trigger);
  });
}
